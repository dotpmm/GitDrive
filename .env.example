# ---- required ----
MONGODB_URI=mongodb+srv://user:pass@cluster/...
DATABASE_NAME=gitdrive_db
GITHUB_TOKEN=ghp_...            # classic PAT with `repo` scope
GITHUB_OWNER=your-github-username
ENCRYPTION_KEY=                 # long random string. NEVER change it or stored files become unreadable
JWT_SECRET=                     # another long random string (signs sessions + download links)

# ---- recommended ----
ADMIN_USERNAMES=prajwal         # comma separated usernames that get the admin panel
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
GITHUB_PRIVATE=false            # public repos hold only ciphertext and are read through GitHub's CDN (faster)

# ---- optional ----
SIGNUPS_ENABLED=true
DEFAULT_QUOTA_GB=0              # per-user quota, 0 = unlimited
MAX_FILE_GB=2
REPO_SIZE_LIMIT_GB=5
API_PUBLIC_URL=                 # only if share links show the wrong host
LOG_MODE=prod

# ---- password reset email (pick one) ----
EMAIL_PROVIDER=none             # none | resend | smtp
# Gmail SMTP (free, works for any recipient): use an App Password, not your real password
# EMAIL_PROVIDER=smtp
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# Resend (free tier only delivers to YOUR OWN address until you verify a domain)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# EMAIL_FROM=GitDrive <onboarding@resend.dev>
